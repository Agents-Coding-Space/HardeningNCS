# HardeningLegacyWin .gitignore

# Outputs - generated backup policies and exports
outputs/*.reg
outputs/*.inf
outputs/backup_*
!outputs/.gitkeep
!outputs/*.csv

# Environment and sensitive data
.env
*.env
*.key
*.pem
token*
credentials*
*.pfx
*.cer

# Temporary and log files
*.tmp
*.log
*.bak
*.swp
*~

# OS & IDE metadata
Thumbs.db
ehthumbs.db
Desktop.ini
.DS_Store
.vscode/
.idea/
